# =========================
# Server
# =========================
PORT=3001
NODE_ENV=development

# =========================
# JWT (must match LMS-BackEnd)
# =========================
JWT_SECRET=your-shared-jwt-secret-here
JWT_ISSUER=lms-backend

# =========================
# LMS-BackEnd Internal API
# =========================
LMS_BACKEND_URL=http://localhost:8082
SERVICE_KEY_SECRET=your-service-key-secret-here

# =========================
# CORS
# =========================
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# Production: allows every https://<tenant>.<domain>, e.g. gradusmind.com.
# localhost origins are accepted only when NODE_ENV is not production.
CORS_ALLOWED_BASE_DOMAIN=

# =========================
# Logging
# =========================
LOG_LEVEL=info

# =========================
# Rate Limiting
# =========================
RATE_LIMIT_MESSAGES_PER_MINUTE=30
RATE_LIMIT_REQUESTS_PER_MINUTE=100
MESSAGE_MAX_LENGTH=4000

# =========================
# Cloudflare R2 Storage
# =========================
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY=your-r2-access-key-id
R2_SECRET_KEY=your-r2-secret-access-key
R2_BUCKET=buildhub-lms
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://pub-your-id.r2.dev


# =========================
# Redis (only when running more than one copy)
# =========================
# Off: one copy, everything in memory. On: messages, presence and the daily
# cleanup job are shared through Redis so several copies act as one.
# If Redis is unreachable at startup the service runs as a single copy.
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=lms-chat:
